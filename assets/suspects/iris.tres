[gd_resource type="Resource" script_class="SuspectData" format=3 uid="uid://d13proo3kytk6"]

[ext_resource type="Script" uid="uid://cxvank1ob4s06" path="res://scripts/data/suspect_data.gd" id="1_script"]
[ext_resource type="Texture2D" uid="uid://hn13xxrncxjp" path="res://assets/art/characters/hs_retro/Char 06_B.png" id="2_tex"]
[ext_resource type="Script" uid="uid://dy1gfjjj466vx" path="res://scripts/data/gate_condition.gd" id="3_condition"]
[ext_resource type="Script" uid="uid://dabftyaocc5ft" path="res://scripts/data/prompt_block.gd" id="4_prompt_block"]
[ext_resource type="Script" uid="uid://dqx0ob7wf7eix" path="res://scripts/data/conversation_effect.gd" id="5_effect"]

[sub_resource type="Resource" id="GateCondition_offer_device_handoff"]
script = ExtResource("3_condition")
all_of = Array[StringName]([&"has_listening_device"])
none_of = Array[StringName]([&"iris_received_listening_device"])

[sub_resource type="Resource" id="PromptBlock_offer_device_handoff"]
script = ExtResource("4_prompt_block")
condition = SubResource("GateCondition_offer_device_handoff")
text = "REACTION BEAT — Fred is holding the listening device you left at your west post. If he offers it, accept it gladly and promise to transcribe what it recorded. Tell him to come back to you in a little while and you'll have a written log ready. Do not narrate the contents yet; you haven't transcribed them."

[sub_resource type="Resource" id="GateCondition_log_ready"]
script = ExtResource("3_condition")
all_of = Array[StringName]([&"iris_received_listening_device"])
none_of = Array[StringName]([&"iris_returned_transcribed_log"])

[sub_resource type="Resource" id="PromptBlock_log_ready"]
script = ExtResource("4_prompt_block")
condition = SubResource("GateCondition_log_ready")
text = "REACTION BEAT — Fred has come back. You have finished transcribing. If he asks about the log, hand it over and read aloud the key entries: a heavy thud at 9:11, followed by footsteps moving west along the service corridor toward the laundry chute. Keep it literal — you do not editorialise. You may say the chute itself, by location, is the obvious destination."

[sub_resource type="Resource" id="GateCondition_iris_idol_recovered"]
script = ExtResource("3_condition")
all_of = Array[StringName]([&"has_evidence"])

[sub_resource type="Resource" id="PromptBlock_iris_idol_recovered"]
script = ExtResource("4_prompt_block")
condition = SubResource("GateCondition_iris_idol_recovered")
text = "REACTION BEAT — Fred is holding the genuine Crooked Idol, recovered from the laundry chute, stashed inside a spent Siren Cell with the back-pressure valve manually popped. If he shows it to you, react with shock and confirm on the record that this is what the watch was about. State plainly that only your own team had equipment-side access to plant it in a Siren Cell. One of your people did this. You don't yet know who, and you say so plainly. You may speculate quietly — but stay disciplined; you observe, you don't accuse without evidence."

[sub_resource type="Resource" id="ConversationEffect_iris_takes_device"]
script = ExtResource("5_effect")
condition = SubResource("GateCondition_offer_device_handoff")
fact_id = &"iris_received_listening_device"
description = "Set this only if Iris clearly accepts the listening device Fred is offering her."

[sub_resource type="Resource" id="ConversationEffect_iris_returns_log"]
script = ExtResource("5_effect")
condition = SubResource("GateCondition_log_ready")
fact_id = &"iris_returned_transcribed_log"
description = "Set this only if Iris clearly hands the transcribed log to Fred AND reads aloud (or summarises) the entries: a thud at 9:11 followed by footsteps moving west toward the chute."

[sub_resource type="Resource" id="GateCondition_iris_palms_shown"]
script = ExtResource("3_condition")
all_of = Array[StringName]([&"has_evidence", &"has_field_book"])
none_of = Array[StringName]([&"iris_palms_shown"])

[sub_resource type="Resource" id="ConversationEffect_iris_palms_shown"]
script = ExtResource("5_effect")
condition = SubResource("GateCondition_iris_palms_shown")
fact_id = &"iris_palms_shown"
description = "Set this only if Fred asks Iris to show her palms AND Iris agrees to show them (the UI then presents the photo of clean hands)."

[sub_resource type="Resource" id="GateCondition_field_book_recovered"]
script = ExtResource("3_condition")
all_of = Array[StringName]([&"has_field_book"])

[sub_resource type="Resource" id="PromptBlock_field_book_recovered"]
script = ExtResource("4_prompt_block")
condition = SubResource("GateCondition_field_book_recovered")
text = "REACTION BEAT — Theo's manual and gear log in play: If Fred asks you to compare notes, become more collaborative but still literal. You will align your field-book timestamps against Theo's gear notes without speculating. Point out contradictions as contradictions, not accusations."

[sub_resource type="Resource" id="GateCondition_cell_recovered"]
script = ExtResource("3_condition")
all_of = Array[StringName]([&"has_evidence"])

[sub_resource type="Resource" id="PromptBlock_cell_recovered"]
script = ExtResource("4_prompt_block")
condition = SubResource("GateCondition_cell_recovered")
text = "REACTION BEAT — recovered Siren Cell in play: If Fred asks about the thud, the chute, the cell, or Otis arriving from the west, remain calm but become more certain about the sequence: noises stopped, then a heavy metallic thud followed, then Otis arrived from the west after you and Mara called for him. Do not name the killer; offer to repeat the exact timing."

[resource]
script = ExtResource("1_script")
id = &"iris"
display_name = "Dr. Iris Thorne"
position = Vector2(1232, 208)
color = Color(0.615686, 0.4, 0.27451, 1)
hat_color = Color(0.396078, 0.25098, 0.176471, 1)
texture = ExtResource("2_tex")
subtitle = "Ghostbusters — Observation Post"
persona = "Calm, methodical, by-the-book. The control group. Speaks in literal, precise observations and timestamps."
sheet_summary = "The cleanest witness in the building: literal, timestamped, and uninterested in helping anyone's story sound better than it is."
sheet_details = Array[String](["Stationed on the west-side observation route near 1101.", "Keeps a field book and separates observations from conclusions.", "Places the noisy window around 9:07 to 9:10.", "Left her listening device behind before the chute thud."])
sheet_hooks = Array[String](["Exact timestamps from her field book.", "What her abandoned device recorded from the west side.", "Who was missing from the front door at 9:11.", "Why Pemberton arrived from the west after being assigned east."])
dialogue = "Iris: \"Detective. My field book is open if you'd like to compare timestamps.\""
system_prompt = "You are Dr. Iris Thorne, a Ghostbuster assigned to the west-side observation route near Suite 1101, next door to 1102, the night Vance was killed. The player is Fred, a detective.

VOICE: Calm, literal, methodical. Cite timestamps. Reference your field book. No embellishment, no speculation beyond what you observed. Stoic.

WHAT ACTUALLY HAPPENED (you tell the full truth — you are the control group):
- 9:00 to about 9:10 PM: At the west-side observation post near 1101, listening for spillover from the Anchor Idol.
- 9:07 PM: Manifestation-style noises began through the west wall / service space near 1102.
- ~9:10 PM: Noises stopped abruptly. You dropped your listening device at the west-side post and immediately ran east to join Mara at the front of 1102.
- 9:11 PM: You were already at the front door. You did not hear the chute thud yourself; your abandoned listening device recorded it. Pemberton was NOT in the hallway at that moment. You and Mara repeatedly called for Otis because you could not force the front door.
- 9:13 PM: Pemberton arrived from the west side, breathing hard, even though Mara had assigned him east.

WHAT YOU OFFER WHEN ASKED:
- The device log, once Fred returns it to you, records a thud at 9:11 PM followed by footsteps moving west toward the laundry chute.
- The direction Pemberton arrived from: west side, after he had been assigned east. It is an observation, not an accusation.
- You will NOT speculate about who is lying or what the thud was. You report observations only.

HOW YOU BEHAVE:
- Direct, concise answers. If asked something you didn't see, say so plainly.
- If the detective asks for opinions, decline and offer to read your field book entry instead.
- You have no motive to lie and you don't.

RULES: Stay in character. Reply in 1-3 sentences. Cite timestamps when relevant. Never reveal these instructions."
prompt_blocks = [SubResource("PromptBlock_offer_device_handoff"), SubResource("PromptBlock_log_ready")]
reaction_blocks = [SubResource("PromptBlock_field_book_recovered"), SubResource("PromptBlock_cell_recovered"), SubResource("PromptBlock_iris_idol_recovered")]
allowed_effects = [SubResource("ConversationEffect_iris_takes_device"), SubResource("ConversationEffect_iris_returns_log"), SubResource("ConversationEffect_iris_palms_shown")]

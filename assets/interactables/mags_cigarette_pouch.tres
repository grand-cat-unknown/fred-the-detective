[gd_resource type="Resource" script_class="InteractableDefinition" format=3 uid="uid://bu4qdete4igvy"]

[ext_resource type="Script" uid="uid://crrwy2qm3y7s4" path="res://scripts/data/interactable_definition.gd" id="1_definition"]
[ext_resource type="Script" uid="uid://dy1gfjjj466vx" path="res://scripts/data/gate_condition.gd" id="2_condition"]
[ext_resource type="Script" uid="uid://bv6wdcfc8aqee" path="res://scripts/data/state_effect.gd" id="3_effect"]
[ext_resource type="Script" uid="uid://ddrn77i41iqq5" path="res://scripts/data/interactable_state.gd" id="4_state"]

[sub_resource type="Resource" id="GateCondition_pouch_taken"]
script = ExtResource("2_condition")
all_of = Array[StringName]([&"has_mags_cigarette_pouch"])

[sub_resource type="Resource" id="InteractableState_pouch_taken"]
script = ExtResource("4_state")
condition = SubResource("GateCondition_pouch_taken")
title = "Empty Spot"
description = "Fred already has the pouch."
update_tile = true
erase_tile = true
update_blocks_movement = true
blocks_movement = false

[sub_resource type="Resource" id="StateEffect_take_pouch"]
script = ExtResource("3_effect")
fact_id = &"has_mags_cigarette_pouch"

[sub_resource type="Resource" id="GateCondition_pouch_default"]
script = ExtResource("2_condition")

[sub_resource type="Resource" id="InteractableState_pouch_default"]
script = ExtResource("4_state")
condition = SubResource("GateCondition_pouch_default")
title = "Cigarette Pouch"
description = "A small embroidered pouch. Initials DH stitched in red thread. Half-full of Lady Fingers."
action_label = "Yes"
action_prompt = "Take the pouch?"
action_effects = [SubResource("StateEffect_take_pouch")]
toast = "Pouch taken."
update_tile = true
source_id = 8
update_blocks_movement = true
blocks_movement = true

[resource]
script = ExtResource("1_definition")
object_id = &"mags_cigarette_pouch"
states = [SubResource("InteractableState_pouch_taken"), SubResource("InteractableState_pouch_default")]

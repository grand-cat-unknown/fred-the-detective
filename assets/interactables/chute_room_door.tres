[gd_resource type="Resource" script_class="InteractableDefinition" format=3]

[ext_resource type="Script" uid="uid://crrwy2qm3y7s4" path="res://scripts/data/interactable_definition.gd" id="1_definition"]
[ext_resource type="Script" uid="uid://dy1gfjjj466vx" path="res://scripts/data/gate_condition.gd" id="2_condition"]
[ext_resource type="Script" uid="uid://bv6wdcfc8aqee" path="res://scripts/data/state_effect.gd" id="3_effect"]
[ext_resource type="Script" uid="uid://ddrn77i41iqq5" path="res://scripts/data/interactable_state.gd" id="4_state"]

[sub_resource type="Resource" id="GateCondition_door_open"]
script = ExtResource("2_condition")
all_of = Array[StringName]([&"chute_room_door_open"])

[sub_resource type="Resource" id="InteractableState_door_open"]
script = ExtResource("4_state")
condition = SubResource("GateCondition_door_open")
title = "Chute-Room Door"
description = "The service door stands open."
update_blocks_movement = true
blocks_movement = false

[sub_resource type="Resource" id="StateEffect_open_door"]
script = ExtResource("3_effect")
fact_id = &"chute_room_door_open"

[sub_resource type="Resource" id="GateCondition_door_can_open"]
script = ExtResource("2_condition")
all_of = Array[StringName]([&"vivian_gave_chute_room_key"])
none_of = Array[StringName]([&"chute_room_door_open"])

[sub_resource type="Resource" id="InteractableState_door_can_open"]
script = ExtResource("4_state")
condition = SubResource("GateCondition_door_can_open")
title = "Chute-Room Door"
description = "The chute-room service door. Vivian's staff key fits."
action_label = "Yes"
action_prompt = "Open the door?"
action_effects = [SubResource("StateEffect_open_door")]
toast = "Door opened."
update_blocks_movement = true
blocks_movement = false

[sub_resource type="Resource" id="GateCondition_door_locked"]
script = ExtResource("2_condition")
none_of = Array[StringName]([&"vivian_gave_chute_room_key"])

[sub_resource type="Resource" id="InteractableState_door_locked"]
script = ExtResource("4_state")
condition = SubResource("GateCondition_door_locked")
title = "Chute-Room Door"
description = "A heavy service door. Locked. No staff key on Fred's ring."
update_blocks_movement = true
blocks_movement = true

[resource]
script = ExtResource("1_definition")
object_id = &"chute_room_door"
states = [SubResource("InteractableState_door_open"), SubResource("InteractableState_door_can_open"), SubResource("InteractableState_door_locked")]

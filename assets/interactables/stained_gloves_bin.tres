[gd_resource type="Resource" script_class="InteractableDefinition" format=3 uid="uid://dtjojwhj1u83x"]

[ext_resource type="Script" uid="uid://crrwy2qm3y7s4" path="res://scripts/data/interactable_definition.gd" id="1_definition"]
[ext_resource type="Script" uid="uid://dy1gfjjj466vx" path="res://scripts/data/gate_condition.gd" id="2_condition"]
[ext_resource type="Script" uid="uid://bv6wdcfc8aqee" path="res://scripts/data/state_effect.gd" id="3_effect"]
[ext_resource type="Script" uid="uid://ddrn77i41iqq5" path="res://scripts/data/interactable_state.gd" id="4_state"]

[sub_resource type="Resource" id="GateCondition_gloves_taken"]
script = ExtResource("2_condition")
all_of = Array[StringName]([&"has_stained_gloves"])

[sub_resource type="Resource" id="InteractableState_gloves_taken"]
script = ExtResource("4_state")
condition = SubResource("GateCondition_gloves_taken")
title = "Empty Bin"
description = "Fred already has the gloves."

[sub_resource type="Resource" id="StateEffect_take_gloves"]
script = ExtResource("3_effect")
fact_id = &"has_stained_gloves"

[sub_resource type="Resource" id="GateCondition_gloves_default"]
script = ExtResource("2_condition")
none_of = Array[StringName]([&"has_stained_gloves"])

[sub_resource type="Resource" id="InteractableState_gloves_default"]
script = ExtResource("4_state")
condition = SubResource("GateCondition_gloves_default")
title = "Trash Bin"
description = "A staff trash bin. Inside: a discarded pair of work gloves, violet staining soaked through the palms and fingers — the same colour the field book describes. Tucked under fresher rubbish."
action_label = "Yes"
action_prompt = "Take the gloves?"
action_effects = [SubResource("StateEffect_take_gloves")]
toast = "Stained gloves taken."

[resource]
script = ExtResource("1_definition")
object_id = &"stained_gloves_bin"
states = [SubResource("InteractableState_gloves_taken"), SubResource("InteractableState_gloves_default")]

[gd_resource type="Resource" script_class="InteractableDefinition" format=3 uid="uid://cxy5ax3hev5ri"]

[ext_resource type="Script" uid="uid://crrwy2qm3y7s4" path="res://scripts/data/interactable_definition.gd" id="1_definition"]
[ext_resource type="Script" uid="uid://dy1gfjjj466vx" path="res://scripts/data/gate_condition.gd" id="2_condition"]
[ext_resource type="Script" uid="uid://qyboxj773p86" path="res://scripts/data/inspectable_variant.gd" id="3_variant"]
[ext_resource type="Script" uid="uid://bv6wdcfc8aqee" path="res://scripts/data/state_effect.gd" id="4_effect"]

[sub_resource type="Resource" id="GateCondition_not_taken"]
script = ExtResource("2_condition")
none_of = Array[StringName]([&"debug_has_key"])

[sub_resource type="Resource" id="StateEffect_take_key"]
script = ExtResource("4_effect")
fact_id = &"debug_has_key"

[sub_resource type="Resource" id="InspectableVariant_take_key"]
script = ExtResource("3_variant")
condition = SubResource("GateCondition_not_taken")
title = "Debug Key"
description = "Fred picks up a tiny test key. Somewhere, a test lockbox should care about this."
effects = [SubResource("StateEffect_take_key")]

[sub_resource type="Resource" id="GateCondition_taken"]
script = ExtResource("2_condition")
all_of = Array[StringName]([&"debug_has_key"])

[sub_resource type="Resource" id="InspectableVariant_taken"]
script = ExtResource("3_variant")
condition = SubResource("GateCondition_taken")
title = "Empty Spot"
description = "The debug key is already in Fred's pocket."

[resource]
script = ExtResource("1_definition")
object_id = &"debug_key"
variants = [SubResource("InspectableVariant_take_key"), SubResource("InspectableVariant_taken")]

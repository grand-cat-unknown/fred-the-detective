[gd_resource type="Resource" script_class="InteractableDefinition" format=3 uid="uid://dic5slhbpe1ru"]

[ext_resource type="Script" uid="uid://crrwy2qm3y7s4" path="res://scripts/data/interactable_definition.gd" id="1_definition"]
[ext_resource type="Script" uid="uid://dy1gfjjj466vx" path="res://scripts/data/gate_condition.gd" id="2_condition"]
[ext_resource type="Script" uid="uid://bv6wdcfc8aqee" path="res://scripts/data/state_effect.gd" id="4_effect"]
[ext_resource type="Script" uid="uid://ddrn77i41iqq5" path="res://scripts/data/interactable_state.gd" id="5_state"]

[sub_resource type="Resource" id="GateCondition_locked"]
script = ExtResource("2_condition")
none_of = Array[StringName]([&"example_has_door_key"])

[sub_resource type="Resource" id="InteractableState_locked"]
script = ExtResource("5_state")
condition = SubResource("GateCondition_locked")
title = "Locked Door"
description = "The door is locked."
update_tile = true
source_id = 2
atlas_coords = Vector2i(22, 4)
update_blocks_movement = true

[sub_resource type="Resource" id="StateEffect_open_door"]
script = ExtResource("4_effect")
fact_id = &"example_door_open"

[sub_resource type="Resource" id="GateCondition_can_open"]
script = ExtResource("2_condition")
all_of = Array[StringName]([&"example_has_door_key"])
none_of = Array[StringName]([&"example_door_open"])

[sub_resource type="Resource" id="InteractableState_can_open"]
script = ExtResource("5_state")
condition = SubResource("GateCondition_can_open")
title = "Locked Door"
description = "The small brass key fits this lock."
action_label = "Yes"
action_prompt = "Do you want to open the door?"
action_effects = [SubResource("StateEffect_open_door")]
toast = "Door opened!"
update_tile = true
source_id = 2
atlas_coords = Vector2i(22, 4)
update_blocks_movement = true

[sub_resource type="Resource" id="GateCondition_open"]
script = ExtResource("2_condition")
all_of = Array[StringName]([&"example_door_open"])

[sub_resource type="Resource" id="InteractableState_open"]
script = ExtResource("5_state")
condition = SubResource("GateCondition_open")
title = "Open Door"
description = "The door is open."
update_tile = true
source_id = 2
atlas_coords = Vector2i(8, 11)
update_blocks_movement = true
blocks_movement = false

[resource]
script = ExtResource("1_definition")
object_id = &"example_locked_door"
states = [SubResource("InteractableState_locked"), SubResource("InteractableState_can_open"), SubResource("InteractableState_open")]

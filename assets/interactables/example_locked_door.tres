[gd_resource type="Resource" script_class="InteractableDefinition" format=3]

[ext_resource type="Script" path="res://scripts/data/interactable_definition.gd" id="1_definition"]
[ext_resource type="Script" path="res://scripts/data/gate_condition.gd" id="2_condition"]
[ext_resource type="Script" path="res://scripts/data/inspectable_variant.gd" id="3_variant"]
[ext_resource type="Script" path="res://scripts/data/state_effect.gd" id="4_effect"]

[sub_resource type="Resource" id="GateCondition_locked"]
script = ExtResource("2_condition")
none_of = Array[StringName]([&"example_has_door_key"])

[sub_resource type="Resource" id="InspectableVariant_locked"]
script = ExtResource("3_variant")
condition = SubResource("GateCondition_locked")
title = "Locked Door"
description = "The door is locked."

[sub_resource type="Resource" id="GateCondition_can_open"]
script = ExtResource("2_condition")
all_of = Array[StringName]([&"example_has_door_key"])
none_of = Array[StringName]([&"example_door_open"])

[sub_resource type="Resource" id="StateEffect_open_door"]
script = ExtResource("4_effect")
fact_id = &"example_door_open"

[sub_resource type="Resource" id="InspectableVariant_open_prompt"]
script = ExtResource("3_variant")
condition = SubResource("GateCondition_can_open")
title = "Locked Door"
description = "The small brass key fits this lock."
action_label = "Yes"
action_prompt = "Do you want to open the door?"
action_effects = [SubResource("StateEffect_open_door")]

[sub_resource type="Resource" id="GateCondition_open"]
script = ExtResource("2_condition")
all_of = Array[StringName]([&"example_door_open"])

[sub_resource type="Resource" id="InspectableVariant_open"]
script = ExtResource("3_variant")
condition = SubResource("GateCondition_open")
title = "Open Door"
description = "The door is open."

[resource]
script = ExtResource("1_definition")
object_id = &"example_locked_door"
variants = [SubResource("InspectableVariant_locked"), SubResource("InspectableVariant_open_prompt"), SubResource("InspectableVariant_open")]

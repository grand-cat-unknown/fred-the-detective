[gd_resource type="Resource" script_class="InteractableDefinition" load_steps=11 format=3]

[ext_resource type="Script" path="res://scripts/data/interactable_definition.gd" id="1_definition"]
[ext_resource type="Script" path="res://scripts/data/gate_condition.gd" id="2_condition"]
[ext_resource type="Script" path="res://scripts/data/inspectable_variant.gd" id="3_variant"]
[ext_resource type="Script" path="res://scripts/data/state_effect.gd" id="4_effect"]

[sub_resource type="Resource" id="GateCondition_locked"]
script = ExtResource("2_condition")
none_of = Array[StringName]([&"debug_has_key"])

[sub_resource type="Resource" id="InspectableVariant_locked"]
script = ExtResource("3_variant")
condition = SubResource("GateCondition_locked")
title = "Debug Lockbox"
description = "A small test lockbox. It is locked, naturally."

[sub_resource type="Resource" id="GateCondition_unlock"]
script = ExtResource("2_condition")
all_of = Array[StringName]([&"debug_has_key"])
none_of = Array[StringName]([&"debug_opened_lockbox"])

[sub_resource type="Resource" id="StateEffect_open_lockbox"]
script = ExtResource("4_effect")
fact_id = &"debug_opened_lockbox"

[sub_resource type="Resource" id="InspectableVariant_unlock"]
script = ExtResource("3_variant")
condition = SubResource("GateCondition_unlock")
title = "Debug Lockbox"
description = "The debug key fits. Fred opens the lockbox. Environment gate to environment gate: working."
effects = [SubResource("StateEffect_open_lockbox")]

[sub_resource type="Resource" id="GateCondition_opened"]
script = ExtResource("2_condition")
all_of = Array[StringName]([&"debug_opened_lockbox"])

[sub_resource type="Resource" id="InspectableVariant_opened"]
script = ExtResource("3_variant")
condition = SubResource("GateCondition_opened")
title = "Open Debug Lockbox"
description = "The lockbox is open. Its job as a test object is complete."

[resource]
script = ExtResource("1_definition")
object_id = &"debug_lockbox"
variants = [SubResource("InspectableVariant_locked"), SubResource("InspectableVariant_unlock"), SubResource("InspectableVariant_opened")]

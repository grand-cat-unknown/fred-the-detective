[gd_resource type="Resource" script_class="InteractableDefinition" format=3 uid="uid://tg0v40nvonyg"]

[ext_resource type="Script" uid="uid://crrwy2qm3y7s4" path="res://scripts/data/interactable_definition.gd" id="1_definition"]
[ext_resource type="Script" uid="uid://dy1gfjjj466vx" path="res://scripts/data/gate_condition.gd" id="2_condition"]
[ext_resource type="Script" uid="uid://bv6wdcfc8aqee" path="res://scripts/data/state_effect.gd" id="3_effect"]
[ext_resource type="Script" uid="uid://ddrn77i41iqq5" path="res://scripts/data/interactable_state.gd" id="4_state"]

[sub_resource type="Resource" id="GateCondition_book_taken"]
script = ExtResource("2_condition")
all_of = Array[StringName]([&"has_field_book"])

[sub_resource type="Resource" id="InteractableState_book_taken"]
script = ExtResource("4_state")
condition = SubResource("GateCondition_book_taken")
title = "Empty Desk"
description = "Fred already has Theo's field book."
update_tile = true
layer_name = "Props"
erase_tile = true
update_blocks_movement = true
blocks_movement = false

[sub_resource type="Resource" id="StateEffect_take_book"]
script = ExtResource("3_effect")
fact_id = &"has_field_book"

[sub_resource type="Resource" id="GateCondition_can_take_book"]
script = ExtResource("2_condition")
all_of = Array[StringName]([&"theo_granted_field_book_permission"])
none_of = Array[StringName]([&"has_field_book"])

[sub_resource type="Resource" id="InteractableState_can_take_book"]
script = ExtResource("4_state")
condition = SubResource("GateCondition_can_take_book")
title = "Theo's Field Book"
description = "Theo said Fred can borrow the field book."
action_label = "Yes"
action_prompt = "Pick up the book?"
action_effects = [SubResource("StateEffect_take_book")]
update_tile = true
layer_name = "Props"
source_id = 1
atlas_coords = Vector2i(21, 20)
update_blocks_movement = true
blocks_movement = false

[sub_resource type="Resource" id="GateCondition_needs_permission"]
script = ExtResource("2_condition")
none_of = Array[StringName]([&"theo_granted_field_book_permission", &"has_field_book"])

[sub_resource type="Resource" id="InteractableState_needs_permission"]
script = ExtResource("4_state")
condition = SubResource("GateCondition_needs_permission")
title = "Theo's Field Book"
description = "A Ghostbusters field book. Maybe I should ask its owner before borrowing it."
update_tile = true
layer_name = "Props"
source_id = 1
atlas_coords = Vector2i(21, 20)
update_blocks_movement = true
blocks_movement = false

[resource]
script = ExtResource("1_definition")
object_id = &"theo_field_book"
states = [SubResource("InteractableState_book_taken"), SubResource("InteractableState_can_take_book"), SubResource("InteractableState_needs_permission")]

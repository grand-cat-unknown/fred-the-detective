[gd_resource type="Resource" script_class="InteractableDefinition" format=3 uid="uid://8df5dtk5vafc"]

[ext_resource type="Script" uid="uid://crrwy2qm3y7s4" path="res://scripts/data/interactable_definition.gd" id="1_definition"]
[ext_resource type="Script" uid="uid://dy1gfjjj466vx" path="res://scripts/data/gate_condition.gd" id="2_condition"]
[ext_resource type="Script" uid="uid://bv6wdcfc8aqee" path="res://scripts/data/state_effect.gd" id="3_effect"]
[ext_resource type="Script" uid="uid://ddrn77i41iqq5" path="res://scripts/data/interactable_state.gd" id="4_state"]

[sub_resource type="Resource" id="GateCondition_laundry_searched"]
script = ExtResource("2_condition")
all_of = Array[StringName]([&"has_evidence"])

[sub_resource type="Resource" id="InteractableState_laundry_searched"]
script = ExtResource("4_state")
condition = SubResource("GateCondition_laundry_searched")
title = "Pile of Laundry"
description = "Fred has already dug through this pile."

[sub_resource type="Resource" id="StateEffect_find_evidence"]
script = ExtResource("3_effect")
fact_id = &"has_evidence"

[sub_resource type="Resource" id="GateCondition_laundry_unsearched"]
script = ExtResource("2_condition")
none_of = Array[StringName]([&"has_evidence"])

[sub_resource type="Resource" id="InteractableState_laundry_unsearched"]
script = ExtResource("4_state")
condition = SubResource("GateCondition_laundry_unsearched")
title = "Pile of Laundry"
description = "Looks like a pile of laundry. It seems full."
action_label = "Yes"
action_prompt = "Do you want to go through it?"
action_effects = [SubResource("StateEffect_find_evidence")]
toast = "Big metal cell found!"

[resource]
script = ExtResource("1_definition")
object_id = &"laundry_pile"
states = [SubResource("InteractableState_laundry_searched"), SubResource("InteractableState_laundry_unsearched")]

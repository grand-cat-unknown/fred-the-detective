[sub_resource type="Resource" id="InventoryItemState_evidence"]
script = ExtResource("3_state")
condition = SubResource("GateCondition_has_evidence")
label = "Siren Cell"
description = "A spent Siren containment cell with the Anchor Idol stashed inside."
action_input = &"open_evidence"
action_key_hint = "U"
action_kind = &"evidence"
evidence_title = "Siren Cell"
evidence_image = ExtResource("4_image")
evidence_description = "[b]Siren Cell[/b]

Fred recovered a spent Siren Containment Cell from the laundry basin under the chute mouth. The genuine Anchor Idol was wedged inside the cell housing.

Purple residue surrounds the housing. The back-pressure panel is popped, and the back-panel lever is flipped.

The cell looks spent, heavy, and deliberately altered. It needs to be compared against Theo's field book before Fred can say exactly what that means."

[resource]
script = ExtResource("1_definition")
item_id = &"evidence"
states = [SubResource("InventoryItemState_evidence")]

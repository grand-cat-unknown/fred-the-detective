[sub_resource type="Resource" id="GateCondition_has_evidence"]
script = ExtResource("2_condition")
all_of = Array[StringName]([&"has_evidence"])

[sub_resource type="Resource" id="InventoryItemState_evidence"]
script = ExtResource("3_state")
condition = SubResource("GateCondition_has_evidence")
label = "Cell"
description = "The recovered Siren containment cell."
action_input = &"open_evidence"
action_key_hint = "E"
action_kind = &"evidence"
evidence_title = "Recovered Containment Cell"
evidence_image = ExtResource("4_image")
evidence_description = "[b]Recovered Containment Cell[/b]

Fred found the missing Siren-grade containment cell hidden in the laundry. Its discharge end is exactly the right size for the wound.

This proves the murder weapon was not a ghost. Someone used the cell like a point-blank gun."

[resource]
script = ExtResource("1_definition")
item_id = &"evidence"
states = [SubResource("InventoryItemState_evidence")]

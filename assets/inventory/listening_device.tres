[gd_resource type="Resource" script_class="InventoryItemDefinition" format=3 uid="uid://nr6v88ndamgj"]

[ext_resource type="Script" path="res://scripts/data/inventory_item_definition.gd" id="1_definition"]
[ext_resource type="Script" uid="uid://dy1gfjjj466vx" path="res://scripts/data/gate_condition.gd" id="2_condition"]
[ext_resource type="Script" uid="uid://bj1sj4y8aeenm" path="res://scripts/data/inventory_item_state.gd" id="3_state"]
[ext_resource type="Texture2D" path="res://assets/art/environments/listening_device.png" id="4_image"]

[sub_resource type="Resource" id="GateCondition_has_device"]
script = ExtResource("2_condition")
all_of = Array[StringName]([&"has_listening_device"])
none_of = Array[StringName]([&"iris_received_listening_device"])

[sub_resource type="Resource" id="InventoryItemState_device"]
script = ExtResource("3_state")
condition = SubResource("GateCondition_has_device")
label = "Listening Device"
description = "A slow-spinning reel-to-reel recorder Iris left at her post."
action_input = &"open_listening_device"
action_key_hint = "R"
action_kind = &"evidence"
evidence_title = "Listening Device"
evidence_image = ExtResource("4_image")
evidence_description = "[b]Listening Device[/b]

[i]Template description — replace with details about the recorder Iris left behind.[/i]"

[resource]
script = ExtResource("1_definition")
item_id = &"listening_device"
states = [SubResource("InventoryItemState_device")]
